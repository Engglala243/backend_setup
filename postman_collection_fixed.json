                      "type": "text"
                    },
                    {
                      "key": "discount_percentage",
                      "value": "18",
                      "type": "text"
                    },
                    {
                      "key": "sku",
                      "value": "SILK-001-UPDATED",
                      "type": "text"
                    },
                    {
                      "key": "stock_quantity",
                      "value": "75",
                      "type": "text"
                    },
                    {
                      "key": "category_id",
                      "value": "category-uuid-here",
                      "type": "text"
                    },
                    {
                      "key": "brand_id",
                      "value": "brand-uuid-here",
                      "type": "text"
                    },
                    {
                      "key": "fabric_id",
                      "value": "fabric-uuid-here",
                      "type": "text"
                    },
                    {
                      "key": "occasion_id",
                      "value": "occasion-uuid-here",
                      "type": "text"
                    },
                    {
                      "key": "border_id",
                      "value": "border-uuid-here",
                      "type": "text"
                    },
                    {
                      "key": "pattern_id",
                      "value": "pattern-uuid-here",
                      "type": "text"
                    },
                    {
                      "key": "size_id",
                      "value": "size-uuid-here",
                      "type": "text"
                    },
                    {
                      "key": "theme_id",
                      "value": "theme-uuid-here",
                      "type": "text"
                    },
                    {
                      "key": "type_id",
                      "value": "type-uuid-here",
                      "type": "text"
                    },
                    {
                      "key": "wash_care_id",
                      "value": "wash-care-uuid-here",
                      "type": "text"
                    },
                    {
                      "key": "fashion_trend_id",
                      "value": "fashion-trend-uuid-here",
                      "type": "text"
                    },
                    {
                      "key": "colors",
                      "value": "[\"color-uuid-1\", \"color-uuid-3\"]",
