                    },
                    {
                      "key": "is_trending",
                      "value": "1",
                      "type": "text"
                    },
                    {
                      "key": "images",
                      "type": "file",
                      "src": []
                    }
                  ]
                },
                "url": {
                  "raw": "{{baseUrl}}/admin/products/product-id-here",
                  "host": ["{{baseUrl}}"],
                  "path": ["admin", "products", "product-id-here"]
                }
              }
            },
            {
              "name": "Delete Product",
              "request": {
                "method": "DELETE",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{adminToken}}"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/admin/products/product-id-here",
                  "host": ["{{baseUrl}}"],
                  "path": ["admin", "products", "product-id-here"]
                }
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Web User",
      "item": [
        {
          "name": "Products",
          "item": [
            {
              "name": "Filter Products",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"category\": \"category-uuid\",\n  \"priceMin\": 500,\n  \"priceMax\": 3000,\n  \"color\": [\"color-uuid-1\"],\n  \"sort\": \"price_low_to_high\",\n  \"page\": 1,\n  \"limit\": 20\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/web/products/filter",
                  "host": ["{{baseUrl}}"],
                  "path": ["web", "products", "filter"]
                }
              }
            },
            {
              "name": "Get Product by ID",
              "request": {
                "method": "GET",
                "url": {
                  "raw": "{{baseUrl}}/web/products/product-id-here",
                  "host": ["{{baseUrl}}"],
                  "path": ["web", "products", "product-id-here"]
                }
              }
            },
            {
              "name": "Get Featured Products",
              "request": {
                "method": "GET",
                "url": {
                  "raw": "{{baseUrl}}/web/products/featured?limit=10",
                  "host": ["{{baseUrl}}"],
                  "path": ["web", "products", "featured"],
                  "query": [
                    {
                      "key": "limit",
                      "value": "10"
                    }
                  ]
                }
              }
            },
            {
              "name": "Search Products",
              "request": {
                "method": "GET",
                "url": {
                  "raw": "{{baseUrl}}/web/products/search?q=silk&limit=20",
                  "host": ["{{baseUrl}}"],
                  "path": ["web", "products", "search"],
                  "query": [
                    {
                      "key": "q",
                      "value": "silk"
                    },
                    {
                      "key": "limit",
                      "value": "20"
                    }
                  ]
                }
              }
            }
          ]
        },
        {
          "name": "Authentication",
          "item": [
            {
              "name": "Send Sign-Up OTP",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john@example.com\",\n  \"phone\": \"9876543210\"\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/web/auth/send-signup-otp",
                  "host": ["{{baseUrl}}"],
                  "path": ["web", "auth", "send-signup-otp"]
                }
              }
            },
            {
              "name": "Login",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "if (pm.response.code === 200) {",
                      "    var jsonData = pm.response.json();",
                      "    pm.collectionVariables.set('webToken', jsonData.data.access_token);",
                      "}"
                    ],
                    "type": "text/javascript"
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"john@example.com\",\n  \"otp\": 1234\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/web/auth/login",
                  "host": ["{{baseUrl}}"],
                  "path": ["web", "auth", "login"]
                }
              }
            }
          ]
        }
